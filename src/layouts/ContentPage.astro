---
import IntakeForm from "@/components/IntakeForm.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { phone, phoneHref } from "@/data/site";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  sections: Array<{ title: string; body: string }>;
  showForm?: boolean;
}

const { title, description, eyebrow, heading, intro, sections, showForm = true } = Astro.props;

const pageThemes: Record<string, { className: string; image: string; alt: string }> = {
  Admissions: {
    className: "theme-warm",
    image: "/photo-care-team.jpg",
    alt: "Supportive intake conversation"
  },
  "Insurance & AHCCCS": {
    className: "theme-sage",
    image: "/photo-insurance-desk.jpg",
    alt: "Insurance paperwork at a care desk"
  },
  "For providers": {
    className: "theme-sky",
    image: "/photo-care-team.jpg",
    alt: "Professional referral support"
  },
  "About H.O.P.E.S.S.": {
    className: "theme-hope",
    image: "/hero-counseling.jpg",
    alt: "Therapy session in a calm room"
  },
  "Residential treatment": {
    className: "theme-home",
    image: "/hero-counseling.jpg",
    alt: "Supportive residential treatment setting"
  },
  "Group therapy": {
    className: "theme-sky",
    image: "/photo-group-session.jpg",
    alt: "Supportive therapy conversation"
  },
  "Individual therapy": {
    className: "theme-hope",
    image: "/photo-group-session.jpg",
    alt: "Individual therapy conversation"
  },
  "Grief & trauma therapy": {
    className: "theme-warm",
    image: "/photo-group-session.jpg",
    alt: "Supportive counseling conversation"
  },
  "Treatment programs": {
    className: "theme-home",
    image: "/hero-counseling.jpg",
    alt: "Treatment program support setting"
  },
  "Privacy Policy": {
    className: "theme-sage",
    image: "/photo-care-team.jpg",
    alt: "Private care coordination"
  },
  "Terms of Use": {
    className: "theme-sky",
    image: "/photo-care-team.jpg",
    alt: "Care coordination support"
  },
  Accessibility: {
    className: "theme-hope",
    image: "/hero-counseling.jpg",
    alt: "Accessible care environment"
  },
  "Coming Soon": {
    className: "theme-sage",
    image: "/photo-group-session.jpg",
    alt: "Care consultation"
  }
};

const pageTheme = pageThemes[eyebrow] ?? {
  className: "theme-hope",
  image: "/hero-counseling.jpg",
  alt: "Supportive treatment setting"
};
---

<BaseLayout title={title} description={description}>
  <section class={`page-hero ${pageTheme.className}`}>
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p>{intro}</p>
      <div class="hero-actions">
        <a class="button primary" href={phoneHref}>Call {phone}</a>
        <a class="button secondary" href="/insurance/">Insurance information</a>
      </div>
    </div>
    <figure class="page-hero-media">
      <img src={pageTheme.image} alt={pageTheme.alt} loading="eager" />
    </figure>
  </section>

  <section class="policy-grid">
    {sections.map((section) => (
      <article>
        <h2>{section.title}</h2>
        <p>{section.body}</p>
      </article>
    ))}
  </section>

  {showForm && (
    <section class="split-section">
      <div>
        <p class="eyebrow">Next step</p>
        <h2>Talk with intake, 24/7.</h2>
        <p class="section-copy">
          Call to discuss treatment options, coverage, or a referral. Share personal and clinical information directly with the intake team.
        </p>
      </div>
      <IntakeForm />
    </section>
  )}
</BaseLayout>
