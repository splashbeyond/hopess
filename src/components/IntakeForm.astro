---
import { phone, phoneHref } from "@/data/site";
---
<aside class="intake-form phone-intake" aria-label="Contact intake">
  <p class="eyebrow">Talk with intake</p>
  <h2>A real conversation. A next step.</h2>
  <p>Call our team to discuss treatment options, insurance questions, or a referral. Office and intake support are available 24/7.</p>
  <a class="button primary" href={phoneHref}>Call {phone}</a>
  <p class="form-note">Please share personal and clinical details directly with the intake team by phone.</p>
</aside>
