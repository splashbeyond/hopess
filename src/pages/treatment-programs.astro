---
import ContentPage from "@/layouts/ContentPage.astro";
import { programs } from "@/data/site";
---

<ContentPage
  title="Treatment Programs in Phoenix | H.O.P.E.S.S."
  description="Explore residential treatment, IOP, therapy, and upcoming ketamine-assisted therapy programs at H.O.P.E.S.S."
  eyebrow="Treatment programs"
  heading="Residential, IOP, and therapy services in one recovery pathway."
  intro="H.O.P.E.S.S. serves adults with substance use concerns, including General Mental Health (GMH) and Serious Mental Illness (SMI) populations. Intake helps review individual needs and the appropriate level of care."
  sections={programs.map((program) => ({ title: program.title, body: program.summary }))}
/>
